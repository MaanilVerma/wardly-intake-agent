# Required: Google AI Studio API key for Gemini 2.5 Flash.
# Get one at https://aistudio.google.com/apikey (free tier, no credit card).
GOOGLE_API_KEY=

# Optional: only needed for the Vapi voice (bonus) path. Get from
# https://dashboard.vapi.ai (Settings → API Keys → Private Key).
VAPI_API_KEY=

# Optional: shared secret for /webhook/* endpoints. When set, every Vapi
# webhook must carry the same value in the X-Vapi-Secret header or it's
# rejected. Leave empty for local dev (logs a startup WARNING). Required
# for any deployment that's reachable from the public internet.
VAPI_WEBHOOK_SECRET=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
