# Required: Google AI Studio API key.
# Free tier, no credit card — https://aistudio.google.com/apikey
# Used by the Gemini fallback chain in app/llm.py.
GOOGLE_API_KEY=

# Optional: only needed if scripting Vapi assistant creation. The Vapi
# dashboard works without it. https://dashboard.vapi.ai → Settings → API Keys.
VAPI_API_KEY=

# Optional but REQUIRED for any non-local deployment.
# Shared secret for /webhook/* endpoints. When set, every Vapi webhook
# must carry the same value in the X-Vapi-Secret header or it's rejected.
# Leave empty for local dev (the server logs a startup WARNING).
VAPI_WEBHOOK_SECRET=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
